# Application Core
NODE_ENV=development
PORT=3000

# Security & Sessions
# REQUIRED in production, at least 32 characters. Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace_with_a_secure_random_string_in_production
# Public address(es) of this app, comma-separated if there are several. Used for CORS and the WebSocket origin check.
CORS_ORIGIN=http://localhost:3000
# Hours of inactivity before a login expires (default 8).
# SESSION_IDLE_HOURS=8

# File Storage (JSON DB Paths)
DATA_DIR=./data

# Set to false when serving over plain http:// (e.g. docker compose on localhost). Defaults to true in production.
# Over a real network ALWAYS use https:// and leave this true.
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (leave unset when none).
# TRUST_PROXY=1

# Optional second secret used only to sign the browser extension's tokens (so rotating SESSION_SECRET does not sign
# every student out). Created automatically on first start; unset = tokens are signed with SESSION_SECRET.
# EXTENSION_TOKEN_SECRET=

# Set when students reach the server through a domain / reverse proxy. The pre-configured extension then uses this
# address instead of the detected LAN address. Example: https://attention.your-school.edu
# PUBLIC_URL=

# Set AUTO_ENV=false to turn off the zero-config helpers (automatic .env creation and moving to the next free port).
# The Docker image does this already.
# AUTO_ENV=false
# Set NO_AUTO_OPEN=true to stop the app opening your browser when it starts.
# NO_AUTO_OPEN=true

# Keep accounts and classes in Google Firestore (free Spark plan) instead of data/*.json. Needed on hosts whose disk is
# wiped on restart (Render free plan). Paste the whole service-account JSON file, or its base64. See docs/deploy-free.md.
# FIREBASE_SERVICE_ACCOUNT=
# On Render, PUBLIC_URL / CORS_ORIGIN / TRUST_PROXY are filled in from RENDER_EXTERNAL_URL automatically.
