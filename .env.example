# Attentix settings. The app creates .env from this file on first start (Docker: run `cp .env.example .env`).
# Lines starting with "#" are optional examples: remove the "#" to use them.

# Application Core
NODE_ENV=development
PORT=3000

# Security
# REQUIRED in production, at least 32 characters. Create one with:  openssl rand -hex 32
SESSION_SECRET=replace_with_a_secure_random_string_in_production
# Public address(es) of this app, comma-separated. Used for CORS and the WebSocket origin check.
CORS_ORIGIN=http://localhost:3000
# Hours of inactivity before a login expires (default 8).
# SESSION_IDLE_HOURS=8
# Signs the extension's tokens, so changing SESSION_SECRET does not sign students out. Created automatically on first start.
# EXTENSION_TOKEN_SECRET=

# Storage
DATA_DIR=./data
# Keep accounts and classes in Google Firestore (free Spark plan) instead of data/*.json. Needed where the disk is wiped on
# restart (Render free plan). Paste the whole service-account JSON, or its base64. See docs/deploy-free.md.
# FIREBASE_SERVICE_ACCOUNT=

# Network
# Set to false only for plain http:// (e.g. Docker on localhost). Over a real network use https:// and keep this true.
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (leave unset when none).
# TRUST_PROXY=1
# Address students should use when they reach the server through a domain or reverse proxy. The pre-configured extension
# uses it instead of the detected network address. Example: https://attention.your-school.edu
# PUBLIC_URL=
# On Render, PUBLIC_URL, CORS_ORIGIN and TRUST_PROXY are filled in automatically from RENDER_EXTERNAL_URL.

# Start-up helpers
# false turns off the automatic .env creation and the move to the next free port (the Docker image already does this).
# AUTO_ENV=false
# true stops the app from opening your browser when it starts.
# NO_AUTO_OPEN=true
