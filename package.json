{
  "name": "attentix",
  "version": "2.1.0",
  "description": "Real-time student attention monitoring system (consent-based, privacy-first)",
  "main": "src/index.js",
  "bin": {
    "attentix": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src public/js \"extension/*.js\" tests",
    "audit:prod": "npm audit --omit=dev",
    "build:exe": "node scripts/build-exe.js"
  },
  "jest": {
    "setupFiles": [
      "./tests/setup.js"
    ]
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "extension/**/*",
      ".env.example",
      "package.json"
    ],
    "targets": [
      "node22-win-x64",
      "node22-macos-x64",
      "node22-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "memorystore": "^1.6.8",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
