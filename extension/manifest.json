{
  "manifest_version": 3,
  "name": "Attentix for Meet & Zoom",
  "version": "2.1.0",
  "description": "Join your class with a class code and share a live attentiveness score from Google Meet and the Zoom web client with your educator. Consent-based, and the toolbar badge always shows what is shared.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://meet.google.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Attentix",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/wc/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
